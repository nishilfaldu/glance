{
  "name": "glance",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a branch into a Glance review map, locally or as a secret link",
  "type": "module",
  "bin": {
    "glance": "cli/dist/bin/glance.js"
  },
  "files": [
    "cli/dist",
    "public/viewer.html"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit && tsc -p fixtures",
    "fixture": "node fixtures/build.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
